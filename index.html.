<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Операція: зустріч із Сонею ❤️</title>
<style>
:root{--pink:#ff6fae;--deep:#e94c91;--ink:#55354a;--cream:#fff8fc}
*{box-sizing:border-box}body{margin:0;min-height:100vh;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);background:radial-gradient(circle at 15% 15%,#ffe0ef,transparent 32%),radial-gradient(circle at 85% 80%,#e7e2ff,transparent 34%),#fff7fb;overflow-x:hidden}
button,input,select,textarea{font:inherit}button{cursor:pointer;border:0}
.top{position:fixed;right:16px;top:14px;z-index:20;display:flex;gap:8px}.soft{background:#ffffffc9;border:1px solid #f6c6dc;color:#91446b;border-radius:999px;padding:9px 13px;box-shadow:0 5px 18px #b64f7b18}
main{min-height:100vh;display:grid;place-items:center;padding:72px 18px 30px}.panel{width:min(680px,100%);background:#ffffffdf;backdrop-filter:blur(12px);border:1px solid #fff;box-shadow:0 22px 70px #b54d7d20;border-radius:30px;padding:clamp(22px,5vw,42px);text-align:center;position:relative;overflow:hidden}
h1{font-size:clamp(27px,5vw,43px);line-height:1.13;margin:10px 0 12px}p{font-size:17px;line-height:1.55;color:#79566b}.eyebrow{color:#d44d8e;font-weight:800;letter-spacing:.12em;text-transform:uppercase;font-size:12px}
.actions{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin:25px 0 8px}.yes{background:linear-gradient(135deg,#ff75b3,#ee4e91);color:white;padding:14px 32px;border-radius:18px;font-weight:800;box-shadow:0 10px 24px #ee4e9145}.no{background:#fff;border:1px solid #f3bfd7;color:#a24a75;padding:14px 28px;border-radius:18px;font-weight:700;position:relative;transition:left .15s,top .15s}
.cat-stage{height:175px;display:flex;justify-content:center;align-items:center;gap:20px;margin:8px auto 10px;position:relative}
.cat{width:112px;height:104px;position:relative;animation:bob 2.5s ease-in-out infinite}.cat:nth-child(2){animation-delay:.4s;transform:scale(.92)}
.face{position:absolute;width:94px;height:78px;left:9px;top:22px;background:#fff0f6;border:3px solid #754d64;border-radius:48% 48% 45% 45%;box-shadow:inset 0 -7px #ffd7e8}
.ear{position:absolute;top:8px;width:34px;height:39px;background:#fff0f6;border:3px solid #754d64;transform:rotate(12deg);clip-path:polygon(50% 0,100% 100%,0 100%)}.ear.left{left:11px}.ear.right{right:11px;transform:rotate(-12deg)}
.eye{position:absolute;top:49px;width:7px;height:10px;background:#55354a;border-radius:50%}.eye.l{left:34px}.eye.r{right:34px}.nose{position:absolute;top:60px;left:45px;width:9px;height:7px;background:#f28ab4;clip-path:polygon(0 0,100% 0,50% 100%)}
.cheek{position:absolute;top:63px;width:15px;height:8px;border-radius:50%;background:#ffb4d0;opacity:.8}.cheek.l{left:17px}.cheek.r{right:17px}
.tail{position:absolute;width:35px;height:42px;border:7px solid #754d64;border-left:0;border-bottom:0;border-radius:0 30px 0 0;right:-2px;bottom:1px;transform:rotate(20deg)}
.heart{position:absolute;color:#ff79ad;animation:float 4s linear infinite;opacity:.8}.heart:nth-child(1){left:12%;top:16%;font-size:22px}.heart:nth-child(2){right:12%;top:28%;font-size:17px;animation-delay:1s}.heart:nth-child(3){left:23%;bottom:8%;font-size:15px;animation-delay:2s}
@keyframes bob{0%,100%{translate:0 0}50%{translate:0 -9px}}@keyframes float{0%{transform:translateY(15px) scale(.8);opacity:0}30%{opacity:.9}100%{transform:translateY(-55px) scale(1.2);opacity:0}}
.slide{display:none;animation:appear .55s ease}.slide.active{display:block}@keyframes appear{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.field{display:grid;gap:8px;text-align:left;margin:18px auto;max-width:430px}.field label{font-weight:750;color:#81536d}.field input,.field select,.field textarea{width:100%;border:1px solid #efc4d8;border-radius:14px;padding:13px 14px;background:#fff;color:#55354a;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:#ed78ad;box-shadow:0 0 0 3px #ffb7d533}
.places{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;max-width:470px;margin:18px auto}.place{padding:14px;border-radius:16px;background:#fff;border:1px solid #f1c6da;color:#74465f;font-weight:700}.place.selected{background:#ffe2ef;border:2px solid #ee6da5}
.note{font-size:13px;color:#9b7890}.progress{height:6px;background:#f9dce9;border-radius:9px;overflow:hidden;margin:0 auto 24px;max-width:300px}.progress span{display:block;height:100%;width:20%;background:linear-gradient(90deg,#ff9cc5,#e94c91);transition:width .3s}
.admin{display:none;text-align:left}.admin h2{text-align:center}.result{background:#fff6fa;border:1px solid #f4c9dc;padding:14px;border-radius:15px;margin:12px 0;overflow-wrap:anywhere}.small{font-size:12px;color:#9a7189}
.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#5e3b50;color:white;padding:10px 16px;border-radius:12px;display:none;z-index:30}
@media(max-width:480px){.cat-stage{height:145px;gap:4px}.cat{scale:.85}.places{grid-template-columns:1fr 1fr}.panel{border-radius:24px}}
</style>
</head>
<body>
<div class="top"><button class="soft" id="musicBtn">♫ Увімкнути музику</button><button class="soft" id="adminBtn">⚙ Для Діми</button></div>
<main><section class="panel" id="guestPanel">
<div class="heart">♥</div><div class="heart">♡</div><div class="heart">♥</div>
<div class="progress"><span id="progress"></span></div>
<div class="slide active" data-slide="0">
 <div class="eyebrow">особливе запрошення</div><div class="cat-stage"><div class="cat"><div class="ear left"></div><div class="ear right"></div><div class="face"><i class="eye l"></i><i class="eye r"></i><i class="nose"></i><i class="cheek l"></i><i class="cheek r"></i></div><i class="tail"></i></div><div class="cat"><div class="ear left"></div><div class="ear right"></div><div class="face"><i class="eye l"></i><i class="eye r"></i><i class="nose"></i><i class="cheek l"></i><i class="cheek r"></i></div><i class="tail"></i></div></div>
 <h1>Сонечко, хочеш зустрітися зі мною? ❤️</h1><p>Я придумав дещо особливе для нас двох...</p>
 <div class="actions"><button class="yes" onclick="go(1)">ТАК ❤️</button><button class="no" id="noBtn">НІ 🙈</button></div><p class="note">P.S. Тут живуть дуже хитрі котики 🐾</p>
</div>
<div class="slide" data-slide="1"><div class="eyebrow">ура, ура, ура!</div><div class="cat-stage"><div class="cat"><div class="ear left"></div><div class="ear right"></div><div class="face"><i class="eye l"></i><i class="eye r"></i><i class="nose"></i><i class="cheek l"></i><i class="cheek r"></i></div></div><div class="cat"><div class="ear left"></div><div class="ear right"></div><div class="face"><i class="eye l"></i><i class="eye r"></i><i class="nose"></i><i class="cheek l"></i><i class="cheek r"></i></div></div></div><h1>УРАААААААА!!! 🎉❤️</h1><p>Котики вже святкують! Тепер залишилося спланувати нашу зустріч.</p><button class="yes" onclick="go(2)">Плануємо! ✨</button></div>
<div class="slide" data-slide="2"><div class="eyebrow">крок 1 із 2</div><div class="cat-stage"><div class="cat"><div class="ear left"></div><div class="ear right"></div><div class="face"><i class="eye l"></i><i class="eye r"></i><i class="nose"></i><i class="cheek l"></i><i class="cheek r"></i></div></div><div class="cat"><div class="ear left"></div><div class="ear right"></div><div class="face"><i class="eye l"></i><i class="eye r"></i><i class="nose"></i><i class="cheek l"></i><i class="cheek r"></i></div></div></div><h1>Коли зустрінемося? 📅</h1><div class="field"><label for="date">Обери зручну дату</label><input type="date" id="date"></div><div class="field"><label for="time">А час?</label><input type="time" id="time"></div><button class="yes" onclick="go(3)">Далі 💗</button></div>
<div class="slide" data-slide="3"><div class="eyebrow">крок 2 із 2</div><div class="cat-stage"><div class="cat"><div class="ear left"></div><div class="ear right"></div><div class="face"><i class="eye l"></i><i class="eye r"></i><i class="nose"></i><i class="cheek l"></i><i class="cheek r"></i></div></div><div class="cat"><div class="ear left"></div><div class="ear right"></div><div class="face"><i class="eye l"></i><i class="eye r"></i><i class="nose"></i><i class="cheek l"></i><i class="cheek r"></i></div></div></div><h1>Де зустрінемося? 📍</h1><p>Обери місце, яке тобі найбільше подобається.</p><div class="places"><button class="place" data-place="Парк">🌳 Парк</button><button class="place" data-place="Кафе">☕ Кафе</button><button class="place" data-place="Прогулянка">🚶 Прогулянка</button><button class="place" data-place="Кіно">🎬 Кіно</button><button class="place" data-place="Інше">✨ Інше</button><button class="place" data-place="У гості">🏡 У гості</button></div><div class="field" id="otherWrap" style="display:none"><label for="other">Напиши свій варіант</label><input id="other" placeholder="Куди хочеш?"></div><div class="field"><label for="message">Повідомлення для Діми (необов'язково)</label><textarea id="message" rows="2" placeholder="Щось приємне або важливе..."></textarea></div><button class="yes" onclick="finish()">Підтвердити ❤️</button></div>
<div class="slide" data-slide="4"><div class="eyebrow">місію виконано</div><div class="cat-stage"><div class="cat"><div class="ear left"></div><div class="ear right"></div><div class="face"><i class="eye l"></i><i class="eye r"></i><i class="nose"></i><i class="cheek l"></i><i class="cheek r"></i></div></div><div class="cat"><div class="ear left"></div><div class="ear right"></div><div class="face"><i class="eye l"></i><i class="eye r"></i><i class="nose"></i><i class="cheek l"></i><i class="cheek r"></i></div></div></div><h1>УРААА! НАША ЗУСТРІЧ ЗАПЛАНОВАНА! ❤️</h1><p id="summary"></p><p>Котики передають вам обом подвійне «мяу» 🐱💕</p></div>
</section>
<section class="panel admin" id="adminPanel"><div class="eyebrow">лише для організатора</div><h2>Панель Діми 🔐</h2><div id="adminLogin"><p>Введи пароль адміністратора.</p><div class="field"><label for="adminPass">Пароль</label><input id="adminPass" type="password" placeholder="Пароль"></div><button class="yes" id="loginBtn">Увійти</button><p class="small">У демоверсії пароль: dima2026. Перед публікацією його потрібно змінити.</p></div><div id="adminData" style="display:none"><div id="results"></div><button class="soft" id="backBtn">← На сайт</button></div></section></main>
<div class="toast" id="toast"></div>
<script>
const slides=[...document.querySelectorAll('.slide')];let current=0,chosenPlace='';let audioCtx=null,oscillators=[],musicOn=false;
function go(n){if(n===3){if(!document.getElementById('date').value||!document.getElementById('time').value){notify('Обери, будь ласка, дату й час 💗');return}}current=n;slides.forEach((s,i)=>s.classList.toggle('active',i===n));document.getElementById('progress').style.width=([20,40,60,80,100][n])+'%';}
function notify(t){let el=document.getElementById('toast');el.textContent=t;el.style.display='block';setTimeout(()=>el.style.display='none',2300)}
const no=document.getElementById('noBtn');function runAway(){const panel=document.getElementById('guestPanel').getBoundingClientRect();const w=no.offsetWidth,h=no.offsetHeight;no.style.position='fixed';no.style.left=Math.max(8,Math.random()*(innerWidth-w-16))+'px';no.style.top=Math.max(8,Math.random()*(innerHeight-h-16))+'px';}
no.addEventListener('mouseenter',runAway);no.addEventListener('click',e=>{e.preventDefault();runAway();notify('Хитрі котики не віддають цю кнопку 😹')});no.addEventListener('touchstart',e=>{e.preventDefault();runAway()},{passive:false});
document.querySelectorAll('.place').forEach(b=>b.addEventListener('click',()=>{chosenPlace=b.dataset.place;document.querySelectorAll('.place').forEach(x=>x.classList.toggle('selected',x===b));document.getElementById('otherWrap').style.display=chosenPlace==='Інше'?'grid':'none'}));
function finish(){if(!chosenPlace){notify('Обери місце зустрічі 💗');return}if(chosenPlace==='Інше'&&!document.getElementById('other').value.trim()){notify('Напиши, яке саме місце 😊');return}
const data={date:document.getElementById('date').value,time:document.getElementById('time').value,place:chosenPlace==='Інше'?document.getElementById('other').value.trim():chosenPlace,message:document.getElementById('message').value.trim(),created:new Date().toLocaleString('uk-UA')};
localStorage.setItem('soniaMeetingResponse',JSON.stringify(data));document.getElementById('summary').textContent=`Дата: ${data.date}. Час: ${data.time}. Місце: ${data.place}.`;go(4);
const telegramText = `❤️ Соня запланувала зустріч!\n\n📅 Дата: ${data.date}\n🕒 Час: ${data.time}\n📍 Місце: ${data.place}\n💌 Повідомлення: ${data.message || 'Немає'}`;
const telegramUrl = 'https://t.me/vlnrGTZIfiU?text=' + encodeURIComponent(telegramText);
const sendBtn = document.createElement('a'); sendBtn.href = telegramUrl; sendBtn.target = '_blank'; sendBtn.rel = 'noopener'; sendBtn.className = 'yes'; sendBtn.style.display = 'inline-block'; sendBtn.style.textDecoration = 'none'; sendBtn.style.marginTop = '12px'; sendBtn.textContent = 'Перейти до Діми в Telegram ✈️';
document.querySelector('[data-slide="4"]').appendChild(sendBtn);
}
document.getElementById('adminBtn').onclick=()=>{document.getElementById('guestPanel').style.display='none';document.getElementById('adminPanel').style.display='block'};
document.getElementById('backBtn').onclick=()=>{document.getElementById('adminPanel').style.display='none';document.getElementById('guestPanel').style.display='block'};
document.getElementById('loginBtn').onclick=()=>{if(document.getElementById('adminPass').value!=='dima2026'){notify('Неправильний пароль');return}document.getElementById('adminLogin').style.display='none';document.getElementById('adminData').style.display='block';let d=JSON.parse(localStorage.getItem('soniaMeetingResponse')||'null');document.getElementById('results').innerHTML=d?`<div class="result"><b>Відповідь отримано ❤️</b><p>Дата: ${escapeHtml(d.date)}</p><p>Час: ${escapeHtml(d.time)}</p><p>Місце: ${escapeHtml(d.place)}</p><p>Повідомлення: ${escapeHtml(d.message||'Немає')}</p><p class="small">Збережено: ${escapeHtml(d.created)}</p></div>`:'<div class="result">Відповідей поки немає.</div>'};
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
document.getElementById('musicBtn').onclick=()=>{if(!musicOn){try{audioCtx=new(window.AudioContext||window.webkitAudioContext)();const notes=[523.25,659.25,783.99,659.25,587.33,698.46,783.99,698.46];let i=0;function play(){if(!musicOn)return;let o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.value=notes[i++%notes.length];g.gain.setValueAtTime(.0001,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(.035,audioCtx.currentTime+.04);g.gain.exponentialRampToValueAtTime(.0001,audioCtx.currentTime+.32);o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+.34);setTimeout(play,390)}musicOn=true;play();document.getElementById('musicBtn').textContent='♫ Вимкнути музику'}catch(e){notify('Музика недоступна в цьому браузері')}}else{musicOn=false;if(audioCtx)audioCtx.close();document.getElementById('musicBtn').textContent='♫ Увімкнути музику'}};
</script></body></html>
